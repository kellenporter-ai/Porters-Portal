rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // HELPER FUNCTIONS
    // ==========================================
    
    // Check if the requesting user has admin custom claim
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the user is the document owner
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // ─── Data shape validators ───

    function validLabReport() {
      let d = request.resource.data;
      return d.studentId is string
        && d.keys().hasAll(['studentId', 'createdAt']);
    }

    // ==========================================
    // USER PROFILES
    // ==========================================
    match /users/{userId} {
      // Students can read their own profile; admin can read all.
      // Public profile data (leaderboard, class roster) is served from a separate collection.
      allow read: if isOwner(userId) || isAdmin();
      
      // Users can create their own profile on first login
      allow create: if isOwner(userId);
      
      // Students can ONLY update these specific safe fields on their own profile.
      // All gamification economy fields (xp, level, currency, inventory, equipped)
      // are modified exclusively by Cloud Functions.
      //
      // Two-level check: affectedKeys() returns TOP-LEVEL keys only, so we first
      // gate on the top-level field ('gamification'), then drill into it to verify
      // only safe sub-fields changed (codename, appearance, classProfiles, etc.).
      //
      // SECURITY NOTE: classProfiles is allowed for appearance saves, but Firestore
      // affectedKeys() cannot distinguish deeper sub-paths within classProfiles.
      // Cloud Functions remain authoritative for the RPG economy.
      allow update: if isAdmin()
        || (isOwner(userId)
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['settings', 'classType', 'lastLoginAt', 'gamification'])
            && (
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(['gamification'])
              || request.resource.data.gamification.diff(resource.data.gamification).affectedKeys()
                  .hasOnly(['codename', 'privacyMode', 'lastLevelSeen', 'appearance', 'classProfiles', 'activeDailyChallenges', 'selectedCharacterModel', 'dismissedAnnouncements'])
            ));
      
      // Only admin can delete user profiles
      allow delete: if isAdmin();
    }

    // ==========================================
    // PUBLIC PROFILES (leaderboard / class roster view)
    // ==========================================
    // Mirror of safe, non-PII fields from /users/{uid}, maintained by the
    // mirrorUserToPublicProfile Cloud Function. Any authenticated user may
    // read; only Cloud Functions (Admin SDK) may write.
    match /public_profiles/{userId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ==========================================
    // WHITELIST (allowed_emails)
    // ==========================================
    match /allowed_emails/{email} {
      // Users can read their own entry (needed for session init);
      // admin can read all.
      allow read: if isAdmin() || (isAuthenticated() && request.auth.token.email == email);
      
      // Only admin can manage the whitelist
      allow write: if isAdmin();
    }

    // ==========================================
    // ASSIGNMENTS (Resources)
    // ==========================================
    match /assignments/{assignmentId} {
      // Any whitelisted user can read assignments
      allow read: if isAuthenticated();

      // Only admin can create/edit/delete assignments
      allow write: if isAdmin();
    }

    // ==========================================
    // ASSIGNMENT KEYS (answer keys — admin only, NEVER student-readable)
    // Phase 1e: keys are extracted from lessonBlocks into this collection.
    // Students receive nothing; grading Cloud Functions use Admin SDK.
    // ==========================================
    match /assignment_keys/{assignmentId} {
      allow read, write: if isAdmin();
    }

    // ==========================================
    // ASSIGNMENT CONTENT (heavy payload — Phase 2a)
    // htmlContent + lessonBlocks moved out of assignments/{id} so the
    // metadata list listener stays small. Content is not secret (answer
    // keys live in assignment_keys, admin-only). Same read access as
    // assignments: any authenticated user; writes admin-only.
    // ==========================================
    match /assignment_content/{assignmentId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ==========================================
    // SUBMISSIONS
    // ==========================================
    match /submissions/{submissionId} {
      // Students can read their own submissions (including assessments), admin reads all
      allow read: if isAdmin() ||
        (isAuthenticated() && resource.data.userId == request.auth.uid);

      // Students can create their own submissions, but NOT assessments
      // (assessments are created server-side via Cloud Functions / Admin SDK)
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.isAssessment != true &&
        request.resource.data.keys().hasOnly([
          'userId', 'userName', 'assignmentId', 'assignmentTitle',
          'metrics', 'submittedAt', 'classType', 'section',
          'blockResponses', 'lessonId', 'lessonTitle'
        ]) &&
        // Metrics must be a map (not a score injection vector)
        request.resource.data.metrics is map;

      // Students can update their own non-assessment submissions; admin can update all
      // Students can also write feedbackReadAt/feedbackReviewedAt on ANY of their own submissions (including assessments)
      allow update: if isAdmin() || (isAuthenticated() &&
        resource.data.userId == request.auth.uid && (
          // Non-assessment: full update with allowed keys
          (resource.data.isAssessment != true &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['userId', 'userName', 'assignmentId', 'assignmentTitle',
                'metrics', 'submittedAt', 'blockResponses',
                'classType', 'section', 'lessonId', 'lessonTitle',
                'feedbackReadAt', 'feedbackReviewedAt', 'studentNotes']) &&
            // Prevent score/status forgery on non-assessment updates
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['score', 'status']) &&
            // F2: cap studentNotes map at 4 KiB total to bound doc growth
            (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['studentNotes']) ||
              request.resource.data.studentNotes.size() <= 4096 && request.resource.data.studentNotes.values().join("").size() + request.resource.data.studentNotes.keys().join("").size() <= 4096))
          ||
          // Assessment: feedback tracking fields + personal study notes
          (request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['feedbackReadAt', 'feedbackReviewedAt', 'studentNotes']) &&
            // F2: cap studentNotes map at 4 KiB total to bound doc growth
            (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['studentNotes']) ||
              request.resource.data.studentNotes.size() <= 4096 && request.resource.data.studentNotes.values().join("").size() + request.resource.data.studentNotes.keys().join("").size() <= 4096))
        ));

      // Only admin can delete submissions
      allow delete: if isAdmin();
    }

    // ==========================================
    // GAMIFICATION — XP Events & Quests
    // ==========================================
    match /xp_events/{eventId} {
      // All authenticated users can read events (needed to display multipliers)
      allow read: if isAuthenticated();
      
      // Only admin can manage XP events
      allow write: if isAdmin();
    }


    // ==========================================
    // LAB REPORTS
    // ==========================================
    match /lab_reports/{reportId} {
      allow read: if isAdmin() || 
        (isAuthenticated() && resource.data.studentId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.studentId == request.auth.uid && validLabReport();
      allow update: if isAuthenticated() && resource.data.studentId == request.auth.uid && validLabReport();
      allow delete: if isAdmin();
    }

    // ==========================================
    // CLASS CONFIGS
    // ==========================================
    match /class_configs/{configId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ==========================================
    // QUESTION BANKS (AI-generated, admin-managed)
    // ==========================================
    match /question_banks/{assignmentId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ==========================================
    // READING MATERIALS (Study content for Practice Sets)
    // ==========================================
    match /reading_materials/{assignmentId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /review_progress/{progressId} {
      // Students can read only their own progress; admin reads all.
      allow read: if isAdmin() ||
        (isAuthenticated() && resource.data.userId == request.auth.uid);
      // Only Cloud Functions write (via admin SDK)
      allow write: if false;
    }

    match /engagement_cooldowns/{docId} {
      allow read, write: if false; // Admin SDK only
    }


    // ==========================================
    // PRACTICE PROGRESS (Proctor Bridge)
    // ==========================================
    // Saved by the parent app (authenticated) when HTML practice sets
    // send portal-save messages. Doc ID = userId_assignmentId.
    match /practice_progress/{docId} {
      // resource == null handles getDoc() on non-existent docs (first visit)
      allow read: if isAuthenticated() &&
        (isAdmin() || resource == null || resource.data.userId == request.auth.uid);
      allow create, update: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
    }

    // ==========================================
    // RESOURCE SESSIONS (Server-observed resource open timestamps)
    // ==========================================
    // Created by startResourceSession Cloud Function.
    // Gates lesson_block_responses writes to prevent pre-fill vulnerabilities.
    match /resource_sessions/{sessionId} {
      allow read: if isAuthenticated() &&
        (isAdmin() || resource.data.userId == request.auth.uid);
      allow create, update: if false; // Admin SDK / Cloud Functions only
      allow delete: if isAdmin();
    }

    // ==========================================
    // LESSON BLOCK RESPONSES (Student input auto-save)
    // ==========================================
    // Saved by the parent app when students interact with lesson blocks.
    // Doc ID = userId_assignmentId_blocks.
    // V2: Requires an active resource_sessions or assessment_sessions doc to prevent pre-fill.
    match /lesson_block_responses/{docId} {
      // resource == null handles getDoc() on non-existent docs (first visit)
      allow read: if isAuthenticated() &&
        (isAdmin() || resource == null || resource.data.userId == request.auth.uid);
      // Students can create a doc if they own it and have an active session.
      // validMetricsSnapshot removed — it was blocking legitimate saves when
      // Proctor's saveMetricsSnapshot wrote values that exceeded arbitrary caps.
      // Server-side validation in calculateFeedbackServerSide is the authoritative
      // defense against metrics poisoning.
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        (
          exists(/databases/$(database)/documents/resource_sessions/$(request.auth.uid + '_' + request.resource.data.assignmentId))
          || exists(/databases/$(database)/documents/assessment_sessions/$(request.resource.data.sessionToken))
        );
      allow update: if isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        (
          // Retake flag clearing doesn't need a session token
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['retakePreFilled'])
          || exists(/databases/$(database)/documents/assessment_sessions/$(request.resource.data.sessionToken))
          || (resource.data.sessionToken != null && exists(/databases/$(database)/documents/assessment_sessions/$(resource.data.sessionToken)))
          || exists(/databases/$(database)/documents/resource_sessions/$(request.auth.uid + '_' + resource.data.assignmentId))
        );
      allow delete: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
    }

    // ==========================================
    // LESSON BLOCK RESPONSES ARCHIVE (soft-delete recovery)
    // ==========================================
    // Auto-archived when fresh-start anti-cheat clears a student's saved responses.
    // Students can create (archive their own), only admins can read (for recovery).
    match /lesson_block_responses_archive/{docId} {
      allow read: if isAuthenticated() && isAdmin();
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
    }

    // ==========================================
    // STUDENT PROGRESS (Legacy HTML files — scoped)
    // ==========================================
    // Old HTML practice sets with baked-in Firebase SDK write here.
    // Kept for backward compatibility until all files migrate to the bridge.
    // Scoped: students can only read/write their own docs (docId starts with their uid).
    match /student_progress/{docId} {
      allow read: if isAuthenticated() &&
        (isAdmin() || docId[0:36] == request.auth.uid || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() &&
        (isAdmin() || resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ==========================================
    // ANNOUNCEMENTS
    // ==========================================
    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ==========================================
    // NOTIFICATIONS
    // ==========================================
    match /notifications/{notificationId} {
      // Students can read their own notifications
      allow read: if isAuthenticated() &&
        (isAdmin() || resource.data.userId == request.auth.uid);
      // Cloud Functions / admin create notifications
      allow create: if isAdmin();
      // Students can mark their own notifications as read
      allow update: if isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow delete: if isAdmin();
    }

    // ==========================================
    // BOSS ENCOUNTERS & QUIZZES
    // ==========================================
    match /boss_encounters/{encounterId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();

      // Distributed damage shards — students need read access for real-time HP
      // Cloud Functions (admin SDK) handle all writes
      match /shards/{shardId} {
        allow read: if isAuthenticated();
        allow write: if false; // Admin SDK only
      }

      // Damage log — students can read (leaderboard display)
      match /damage_log/{entryId} {
        allow read: if isAuthenticated();
        allow write: if false; // Admin SDK only
      }
    }

    match /boss_quizzes/{quizId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();

      // Distributed damage shards for quiz bosses
      match /shards/{shardId} {
        allow read: if isAuthenticated();
        allow write: if false; // Admin SDK only
      }

      // Live damage log for battle feed (written by Cloud Function)
      match /damage_log/{logId} {
        allow read: if isAuthenticated();
        allow write: if false; // Admin SDK only
      }
    }

    // Boss quiz progress — students can read their own progress
    match /boss_quiz_progress/{progressId} {
      allow read: if isAuthenticated();
      allow write: if false; // Admin SDK only
    }

    // ==========================================
    // BOSS EVENTS (Unified v2 — quiz + encounter)
    // ==========================================
    match /boss_events/{eventId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();

      // Distributed damage shards — students need read access for real-time HP
      match /shards/{shardId} {
        allow read: if isAuthenticated();
        allow write: if false; // Admin SDK only
      }

      // Damage log — students can read (leaderboard display)
      match /damage_log/{entryId} {
        allow read: if isAuthenticated();
        allow write: if false; // Admin SDK only
      }
    }

    // Boss event progress — students can read their own progress
    match /boss_event_progress/{progressId} {
      allow read: if isAuthenticated();
      allow write: if false; // Admin SDK only
    }

    // ==========================================
    // DAILY CHALLENGES
    // ==========================================
    match /daily_challenges/{challengeId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ==========================================
    // KNOWLEDGE GATES
    // ==========================================
    match /knowledge_gates/{gateId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ==========================================
    // SEASONAL COSMETICS
    // ==========================================
    match /seasonal_cosmetics/{cosmeticId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ==========================================
    // EARLY WARNING SYSTEM (Student Alerts)
    // ==========================================
    match /student_alerts/{alertId} {
      // Only admin/teacher can read alerts
      allow read: if isAdmin();
      // Only Cloud Functions create alerts; admin can update (dismiss)
      allow create: if false;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ==========================================
    // TELEMETRY BUCKETS (EWS Enhancement)
    // ==========================================
    match /student_buckets/{bucketId} {
      // Only admin/teacher can read bucket profiles
      allow read: if isAdmin();
      // Only Cloud Functions create/update bucket profiles
      allow create: if false;
      allow update: if false;
      allow delete: if isAdmin();
    }


    // ==========================================
    // BOSS QUESTION BANKS
    // ==========================================
    match /boss_question_banks/{bankId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ==========================================
    // BUG REPORTS
    // ==========================================
    match /bug_reports/{reportId} {
      // Admin can read all reports
      allow read: if isAdmin();
      // Any authenticated user can submit a bug report
      allow create: if isAuthenticated();
      // Only admin can update (resolve) or delete
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ==========================================
    // SONG REQUESTS
    // ==========================================
    match /song_requests/{requestId} {
      // Admin can read all requests
      allow read: if isAdmin();
      // Any authenticated user can submit a song request
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly(['userId', 'userName', 'song', 'artist', 'timestamp', 'status'])
        && request.resource.data.status == 'pending';
      // Only admin can update (mark played/dismissed) or delete
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ==========================================
    // ENROLLMENT CODES
    // ==========================================
    match /enrollment_codes/{codeId} {
      // Admin-only: prevents code enumeration
      allow read: if isAdmin();
      // Only admin can create codes
      allow create: if isAdmin();
      // Redemption now handled by Cloud Function (atomic transaction) — admin-only direct updates
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ==========================================
    // BEHAVIOR QUICK-AWARDS
    // ==========================================
    match /behavior_awards/{awardId} {
      // Admin can read all; students can read their own awards
      allow read: if isAdmin() ||
        (isAuthenticated() && resource.data.studentId == request.auth.uid);
      // Only admin can create awards
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ==========================================
    // ASSESSMENT SESSIONS (Admin read for draft tracking, writes via Admin SDK only)
    // ==========================================
    match /assessment_sessions/{sessionId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ==========================================
    // CUSTOM ITEMS (Admin-managed item library)
    // ==========================================
    match /customItems/{itemId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ==========================================
    // GRADING CORRECTIONS (Append-only audit log)
    // ==========================================
    match /grading_corrections/{correctionId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // Admin-only collection — all documents require admin claim.
    // If a future doc needs student-read access, add a specific rule above this one.
    match /adminSettings/{docId} {
      allow read, write: if isAdmin();
    }

    // ==========================================
    // WELLNESS CHECK-INS
    // ==========================================
    match /wellness_checkins/{docId} {
      allow create, update: if isAuthenticated()
        && request.auth.uid != null
        && docId.matches(request.auth.uid + '_[0-9]{4}-[0-9]{2}-[0-9]{2}');
      allow delete: if isAuthenticated()
        && docId.matches(request.auth.uid + '_[0-9]{4}-[0-9]{2}-[0-9]{2}');
      allow read: if isAdmin()
        || (isAuthenticated() && docId.matches(request.auth.uid + '_[0-9]{4}-[0-9]{2}-[0-9]{2}'));
    }

    // ==========================================
    // WEEKLY ENGAGEMENT SNAPSHOTS (v2 EWS)
    // Written by Cloud Functions (admin SDK bypasses rules).
    // Admin read-only via client SDK.
    // ==========================================
    match /weeklyEngagementSnapshots/{studentId}/snapshots/{week} {
      allow read: if isAdmin();
      allow write: if false; // Cloud Functions use admin SDK — client writes blocked
    }

    // ==========================================
    // LIBRARY ITEMS (Hosted Content Library registry)
    // Teacher-only: students get no access.
    // ==========================================
    match /library_items/{itemId} {
      allow read, write: if isAdmin();
    }

    match /teacherSnippets/{uid} {
      allow read, write: if isAuthenticated() && (isAdmin() || request.auth.uid == uid);
    }

    match /integrity_reports/{document=**} {
      allow read: if isAdmin();
      allow write: if isAdmin(); // CF writes bypass rules; client saveIntegrityReport is teacher/admin-facing
    }

    // Admin audit trail: written only by Cloud Functions (callable awardXP
    // admin adjustment path). Admin-read-only; no client writes.
    match /admin_actions/{actionId} {
      allow read: if isAdmin();
      allow write: if false; // Cloud Functions bypass rules
    }

    // ==========================================
    // DRIVING QUESTION BOARD (DQB)
    // Top-level collections, section-scoped, initials-only.
    // ==========================================

    // Does the requesting student's section (per their user doc) intersect the
    // given board's `sections` array? Mirrors getUserSectionForClass() in
    // types.ts: check classSections[classType] first, then the legacy `section`
    // field when the user is enrolled in that class.
    function studentInBoardSection(boardData) {
      let user = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      let userSection = (
        user.classSections != null && user.classSections.get(boardData.classType, null) != null
          ? user.classSections.get(boardData.classType)
          : (
              (user.classType == boardData.classType
                || (user.enrolledClasses != null && user.enrolledClasses.hasAny([boardData.classType])))
                ? user.section
                : null
            )
      );
      return userSection != null && boardData.sections.hasAny([userSection]);
    }

    // ─── question_boards/{boardId} ───
    match /question_boards/{boardId} {
      allow read: if isAdmin() ||
        (isAuthenticated() && resource.data.status != 'archived' && studentInBoardSection(resource.data));
      allow create: if isAdmin() &&
        request.resource.data.keys().hasOnly([
          'title', 'prompt', 'classType', 'sections', 'schoolYear',
          'status', 'seedQuestion', 'createdBy', 'createdAt'
        ]) &&
        request.resource.data.title is string && request.resource.data.title.size() <= 200 &&
        request.resource.data.prompt is string && request.resource.data.prompt.size() <= 2000 &&
        request.resource.data.classType is string && request.resource.data.classType.size() <= 100 &&
        request.resource.data.sections is list && request.resource.data.sections.size() > 0 &&
        request.resource.data.sections.size() <= 50 &&
        request.resource.data.schoolYear is string && request.resource.data.schoolYear.size() <= 20 &&
        request.resource.data.status in ['open', 'frozen', 'archived'] &&
        (!request.resource.data.keys().hasAny(['seedQuestion']) ||
          (request.resource.data.seedQuestion is string && request.resource.data.seedQuestion.size() <= 500)) &&
        request.resource.data.createdBy is string;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ─── board_questions/{qid} ───
    match /board_questions/{qid} {
      allow read: if isAdmin() || (isAuthenticated() && studentInBoardSection(
        get(/databases/$(database)/documents/question_boards/$(resource.data.boardId)).data));

      // Students create pending questions on an open board in their section.
      // Students cannot categorize at post time — categoryId must be null (hasOnly
      // ensures the key is present exactly so this null check is enforced).
      // Admins (teachers) may seed live questions with any status/category.
      allow create: if isAdmin() ||
        (isAuthenticated() && !isAdmin() &&
        request.resource.data.keys().hasOnly([
          'boardId', 'text', 'initials', 'authorId', 'categoryId', 'status', 'createdAt'
        ]) &&
        request.resource.data.authorId == request.auth.uid &&
        request.resource.data.text is string &&
        request.resource.data.text.size() >= 10 && request.resource.data.text.size() <= 280 &&
        request.resource.data.initials is string &&
        request.resource.data.initials.size() >= 2 && request.resource.data.initials.size() <= 3 &&
        request.resource.data.categoryId == null &&
        request.resource.data.status == 'pending' &&
        request.resource.data.boardId is string &&
        studentInBoardSection(
          get(/databases/$(database)/documents/question_boards/$(request.resource.data.boardId)).data) &&
        get(/databases/$(database)/documents/question_boards/$(request.resource.data.boardId)).data.status == 'open');

      // Students may ONLY change categoryId, and only while the board is open.
      allow update: if isAdmin() || (isAuthenticated() && !isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['categoryId']) &&
        get(/databases/$(database)/documents/question_boards/$(resource.data.boardId)).data.status == 'open');

      allow delete: if isAdmin();
    }

    // ─── board_categories/{cid} ───
    match /board_categories/{cid} {
      allow read: if isAdmin() || (isAuthenticated() && studentInBoardSection(
        get(/databases/$(database)/documents/question_boards/$(resource.data.boardId)).data));

      // Students create categories on an open board in their section.
      allow create: if isAdmin() || (isAuthenticated() &&
        request.resource.data.keys().hasOnly(['boardId', 'name', 'createdBy', 'createdAt']) &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.name is string &&
        request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 40 &&
        request.resource.data.boardId is string &&
        studentInBoardSection(
          get(/databases/$(database)/documents/question_boards/$(request.resource.data.boardId)).data) &&
        get(/databases/$(database)/documents/question_boards/$(request.resource.data.boardId)).data.status == 'open');

      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ─── board_endorsements/{eid} ───
    // Doc id = `${questionId}_${userId}` — one endorsement per student per question.
    match /board_endorsements/{eid} {
      allow read: if isAdmin() || (isAuthenticated() && studentInBoardSection(
        get(/databases/$(database)/documents/question_boards/$(resource.data.boardId)).data));

      // Students endorse questions on an open board in their section.
      allow create: if isAuthenticated() &&
        request.resource.data.keys().hasOnly(['questionId', 'boardId', 'userId', 'createdAt']) &&
        request.resource.data.userId == request.auth.uid &&
        eid == request.resource.data.questionId + '_' + request.auth.uid &&
        request.resource.data.questionId is string &&
        request.resource.data.boardId is string &&
        !exists(/databases/$(database)/documents/board_endorsements/$(eid)) &&
        studentInBoardSection(
          get(/databases/$(database)/documents/question_boards/$(request.resource.data.boardId)).data) &&
        get(/databases/$(database)/documents/question_boards/$(request.resource.data.boardId)).data.status == 'open';

      allow update: if isAdmin();
      allow delete: if isAdmin() ||
        (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    // ==========================================
    // CATCH-ALL: Deny everything else
    // ==========================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
